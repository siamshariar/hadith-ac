# Copy to .env.local (development) or set in the deployment environment.

# Quran API base URL; the hadith endpoints are under {base}/hadith.
# Read at build time for the browser bundle (NEXT_PUBLIC_).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8090/api

# Public site URL. REQUIRED in production: permalinks, copied citations,
# canonical links and share URLs are built from it (default http://localhost:3000).
# Production: NEXT_PUBLIC_SITE_URL=https://hadith.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics (optional).
GOOGLE_ANALYTICS_ID=
MEASUREMENT_ID=
