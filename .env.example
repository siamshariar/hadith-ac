# hadith-vn settings. Copy to .env.local for development; for a deployment, set them in
# the environment of `npm run build` (docs/DEPLOY.md).
#
# NEXT_PUBLIC_ values and GOOGLE_ANALYTICS_ID are written into the build (server and
# browser code) when `next build` runs: changing one means building again. Each country
# is its own build. `next build` refuses a build that cannot work (next.config.js).

# Country of this site: a key of config/countries.json (vn, bd, usa, kh, fr, ph, jp, de,
# cn, pt, kr, dk, sa, pk, ru, iq). It sets the default content language, the interface
# language (English when lib/locales has no catalog for it; no right-to-left interface
# yet), og:locale, and the default site name, logo and contact email.
# REQUIRED for `next build`; `next dev` defaults to vn.
NEXT_PUBLIC_COUNTRY_CODE=vn

# Public address of the site, at the root of its domain, without a trailing slash:
# canonical links, permalinks, copied citations, share links, robots.txt and the sitemap
# are built from it. REQUIRED for production builds, and not localhost or 127.0.0.1.
# Production: NEXT_PUBLIC_SITE_URL=https://hadith.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the Quran API; the hadith endpoints are under {base}/hadith. The server
# calls it to render pages, and readers' browsers call it directly (search, lists,
# paging), so it must be a public HTTPS address in production (the API allows any origin
# through CORS). REQUIRED for production builds, and https.
# Production: NEXT_PUBLIC_API_BASE_URL=https://api.alquranarabia.com/api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8090/api

# Optional: the site name in titles, the header and the web app manifest. Default: the
# country's siteName in config/countries.json, else "Hadith".
NEXT_PUBLIC_SITE_NAME=

# Optional: the address readers write to (contact, support, error reports). Default: the
# country's contactEmail in config/countries.json, else deeniinfotech@gmail.com.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty: no analytics.
GOOGLE_ANALYTICS_ID=

# Local test builds only: ALLOW_LOCAL_BUILD=1 lets `next build` use a local or http
# site and API address (e.g. to try a production build on 127.0.0.1). Never set it
# for a build that is deployed.
ALLOW_LOCAL_BUILD=
